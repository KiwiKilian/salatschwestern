{
  "name": "salatschwestern-backend",
  "author": "Kilian Finger",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm run lint:tsc && npm run lint:eslint",
    "lint:tsc": "tsc --noemit",
    "lint:eslint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typeorm": "ts-node --require tsconfig-paths/register ./node_modules/typeorm/cli --dataSource src/ormconfig.ts",
    "typeorm-seeding": "ts-node --require tsconfig-paths/register ./node_modules/@jorgebodega/typeorm-seeding/dist/cli --dataSource src/ormconfig.ts",
    "db:reset": "npm run typeorm schema:drop && npm run typeorm migration:run && npm run typeorm-seeding seed src/seeds/development.seeder.ts"
  },
  "prettier": "@kiwikilian/prettier-config",
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/terminus": "10.3.0",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "currency.js": "2.0.4",
    "dayjs": "1.11.21",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-basic-auth": "1.2.1",
    "joi": "18.2.3",
    "nestjs-slack": "2.0.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slack-block-builder": "2.8.0",
    "typeorm": "0.3.30"
  },
  "devDependencies": {
    "@jorgebodega/typeorm-seeding": "7.1.0",
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@kiwikilian/eslint-config": "1.1.0",
    "@kiwikilian/prettier-config": "1.0.1",
    "@types/express": "4.17.25",
    "@types/node": "24.13.2",
    "eslint": "8.57.1",
    "prettier": "3.8.4",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
